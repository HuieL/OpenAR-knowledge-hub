{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuieL/OpenAR-knowledge-hub/schemas/knowledge-package.schema.json",
  "title": "OpenAR Knowledge Package",
  "description": "Groups several knowledge records and the evidence/experiments they share. Records stay the unit agents retrieve; scripts/validate.py is the authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "summary",
    "records",
    "credit",
    "license",
    "publication"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,39}\\.[a-z0-9][a-z0-9-]{0,87}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^evidence/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "config": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "record",
              "dataset",
              "code",
              "paper",
              "model"
            ]
          },
          "ref": {
            "type": "string"
          },
          "pinned": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedOutputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "type": "string"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "withheld": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verifiabilityImpact": {
          "type": "string"
        }
      }
    },
    "credit": {
      "type": "object"
    },
    "license": {
      "type": "string"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "published"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "accepted",
            "retracted",
            "superseded"
          ]
        },
        "published": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      }
    }
  }
}
