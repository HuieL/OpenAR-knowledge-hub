{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuieL/OpenAR-knowledge-hub/schemas/reproduction-profile.schema.json",
  "title": "OpenAR Knowledge Package reproduction profile (v1)",
  "description": "evidence/reproduction.profile.json in a package: the single source of its reproduction contract. The package's legacy reproduction text is generated from it. Unknown values are null and listed in missing; values not typed by the author carry their source. Never executed by the registry. scripts/validate.py is the authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "intent",
    "records",
    "experiments"
  ],
  "properties": {
    "profileVersion": {
      "const": 1
    },
    "intent": {
      "enum": [
        "analysis-recompute",
        "independent-rerun",
        "transfer-validation"
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,39}\\.[a-z0-9][a-z0-9-]{0,87}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "relations": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "enum": [
                "supports",
                "contradicts",
                "qualifies",
                "inconclusive"
              ]
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "entry": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "patches": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "os": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "arch": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "lockfile": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "parameters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 40
                },
                "value": {
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "integer",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 40
                },
                "required": {
                  "type": "boolean"
                },
                "adjustable": {
                  "type": "boolean"
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "run-config",
                        "run-record",
                        "author",
                        "agent-suggested"
                      ]
                    },
                    "ref": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          },
          "inputs": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "dataset",
                    "model",
                    "file",
                    "code",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                },
                "split": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "access": {
                  "enum": [
                    "public",
                    "restricted",
                    "private",
                    "unknown",
                    null
                  ]
                }
              }
            }
          },
          "procedure": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "command"
              ],
              "properties": {
                "step": {
                  "enum": [
                    "setup",
                    "run",
                    "evaluate",
                    "analyze"
                  ]
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "workdir": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 300
                },
                "outputs": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "baseline": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "metric": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "denominator": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "seeds": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 32,
                "items": {
                  "type": "integer"
                }
              },
              "repetitions": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "outputContract": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "scorer": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "tolerance": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "metric": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 200
                      },
                      "abs": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "rel": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "gpu": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "ramGb": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "diskGb": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "cost": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              }
            }
          },
          "results": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expectedArtifacts": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "supportsIf": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "refutesIf": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "invalidIf": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "files": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "notReproducible": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
